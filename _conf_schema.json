{
  "enable": {
    "description": "启用记忆与人格",
    "type": "bool",
    "default": true
  },
  "db_path": {
    "description": "数据库路径",
    "type": "string",
    "hint": "留空使用 data/plugin_data/astrbot_plugin_memory_evo/memory.db",
    "default": ""
  },
  "top_k": {
    "description": "每轮注入的记忆条数",
    "type": "int",
    "hint": "建议 4-8。条数越多越容易干扰当前话题。",
    "default": 6
  },
  "max_inject_chars": {
    "description": "记忆注入字符上限",
    "type": "int",
    "hint": "600 字符约 400 token。别超过上下文窗口的 10%。",
    "default": 600
  },
  "persona_inject": {
    "description": "注入人格状态",
    "type": "bool",
    "default": true
  },
  "persona_max_chars": {
    "description": "人格状态字符上限",
    "type": "int",
    "default": 160
  },
  "persona_evolve": {
    "description": "启用人格演化",
    "type": "bool",
    "default": true
  },
  "max_step": {
    "description": "单次演化最大步长",
    "type": "float",
    "hint": "0.06 表示每次最多变化 6%。调小更稳，调大更戏剧化。",
    "default": 0.06
  },
  "decay": {
    "description": "向基线回归系数",
    "type": "float",
    "hint": "0.01 表示每轮演化向基线拉回 1%，防止长期漂到极值。",
    "default": 0.01
  },
  "baseline_intimacy": {
    "description": "基线：亲密度",
    "type": "float",
    "default": 0.5
  },
  "baseline_playfulness": {
    "description": "基线：跳脱度",
    "type": "float",
    "default": 0.5
  },
  "baseline_directness": {
    "description": "基线：直给度",
    "type": "float",
    "default": 0.5
  },
  "baseline_initiative": {
    "description": "基线：主动度",
    "type": "float",
    "default": 0.5
  },
  "baseline_warmth": {
    "description": "基线：温度",
    "type": "float",
    "default": 0.5
  },
  "semantic_recall": {
    "description": "语义召回",
    "type": "bool",
    "hint": "有 embedding provider 时用向量相似度召回，失败自动退回字面匹配。",
    "default": true
  },
  "embedding_provider_id": {
    "description": "Embedding 提供商 ID",
    "type": "string",
    "hint": "留空则自动使用第一个可用的 embedding 提供商。",
    "default": ""
  },
  "embedding_timeout": {
    "description": "Embedding 请求超时（秒）",
    "type": "int",
    "default": 10
  },
  "min_confidence": {
    "description": "注入所需最低置信度",
    "type": "float",
    "hint": "低于此值且重要度<5 的事实只入库不注入，避免抽错就当真。",
    "default": 0.45
  },
  "include_suspect": {
    "description": "注入待确认记忆",
    "type": "bool",
    "hint": "默认 false。开启后冲突事实也会进上下文，容易自相矛盾。",
    "default": false
  },
  "max_per_predicate": {
    "description": "同一槽位最多注入条数",
    "type": "int",
    "hint": "防止「饮食」类记忆占满预算。",
    "default": 2
  },
  "max_item_chars": {
    "description": "单条记忆注入最大字符",
    "type": "int",
    "hint": "超出截断，避免一条长记忆吃掉整个预算。",
    "default": 80
  },
  "care_enable": {
    "description": "主动消息",
    "type": "bool",
    "hint": "关闭时下面所有项都不生效。只对私聊会话生效。",
    "default": false
  },
  "care_min_idle_minutes": {
    "description": "最少空闲分钟数",
    "type": "int",
    "hint": "用户安静多久之后才考虑主动开口。",
    "default": 90
  },
  "care_daily_max": {
    "description": "每日主动上限",
    "type": "int",
    "hint": "一天最多主动发几条，防止变成打扰。",
    "default": 3
  },
  "care_max_unanswered": {
    "description": "连续未回应上限",
    "type": "int",
    "hint": "连续几次主动都没被回复就停下来，等用户先说话。",
    "default": 2
  },
  "care_quiet_start": {
    "description": "免打扰开始",
    "type": "string",
    "hint": "HH:MM，支持跨零点，例如 23:30。",
    "default": "23:30"
  },
  "care_quiet_end": {
    "description": "免打扰结束",
    "type": "string",
    "hint": "HH:MM，例如 08:00。",
    "default": "08:00"
  },
  "care_probability": {
    "description": "触发概率",
    "type": "float",
    "hint": "满足条件后仍有这个概率才真的发，避免过于规律。",
    "default": 0.85
  },
  "care_max_chars": {
    "description": "消息长度上限",
    "type": "int",
    "hint": "主动消息的字符数，短一点更像真人。",
    "default": 45
  },
  "care_timezone": {
    "description": "时区",
    "type": "string",
    "hint": "用于免打扰判断与提示词里的当前时间。",
    "default": "Asia/Shanghai"
  },
  "care_provider_id": {
    "description": "生成用 Provider ID",
    "type": "string",
    "hint": "留空复用抽取模型（extract_provider_id）或当前会话模型。",
    "default": ""
  },
  "flush_turns": {
    "description": "多少轮用户消息触发一次记忆抽取",
    "type": "int",
    "hint": "越大越省 token，但记忆越滞后。",
    "default": 6
  },
  "idle_seconds": {
    "description": "空闲多少秒后补写缓冲",
    "type": "int",
    "default": 60
  },
  "max_buffer": {
    "description": "单会话缓冲消息上限",
    "type": "int",
    "default": 40
  },
  "extract_provider_id": {
    "description": "抽取用模型提供商 ID",
    "type": "string",
    "hint": "留空复用当前会话模型。建议填一个便宜的模型以省钱。",
    "default": ""
  },
  "llm_timeout": {
    "description": "抽取请求超时（秒）",
    "type": "int",
    "default": 45
  }
}